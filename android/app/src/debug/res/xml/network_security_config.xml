<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- Debug builds may connect to a backend on the developer's private LAN. -->
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>

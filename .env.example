# Local development only. Never commit real credentials.
POSTGRES_DB=tareh
POSTGRES_USER=tareh
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_PORT=5432
REDIS_PORT=6379

# Use the same URL in backend/.env for local Prisma/Nest commands.
DATABASE_URL=postgresql://tareh:change_this_local_password@localhost:5432/tareh?schema=public
REDIS_URL=redis://localhost:6379

API_PORT=3000
API_CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
JWT_ACCESS_SECRET=local_only_change_to_a_random_32_character_secret
OTP_HASH_SECRET=local_only_change_to_a_random_32_character_secret
OTP_CODE_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=3


# SportMonks Football API v3 (server-side only).
SPORTMONKS_API_TOKEN=
SPORTMONKS_API_BASE_URL=https://api.sportmonks.com/v3/football

# TheSportsDB free V1 key is public by design; used for logo/team metadata enrichment only.
THESPORTSDB_API_KEY=123
THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json
